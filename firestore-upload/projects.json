          "  camera.lookAt(0, 0, 0);",
          "...",
          "});"
        ],
        "aftercode": [
          "// GLB 모델 로드 중심 정렬 후 그룹에 추가",
          "loader.load(\"keyboard2.glb\", function (gltf) {",
