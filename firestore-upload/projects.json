          "Loadtl 텍스트 GSAP 타임라인 안에서 .call(() => introAnimation())으로 정확한 3D 모델 등장 애니메이션 실행 및 타이밍 제어",
          "메인페이지의 푸터에 도착했을 때 3D 모델의 아웃 애니메이션이 진행되도록 footerTl .call(() => outAnimation())으로 정확한 타이밍 제어"
        ],
        "beforecode": [
          "// GLB 모델 로드 세팅 내에서 인/아웃 애니메이션 호출",
          "loader.load(\"./assets/glb/keyboard2.glb\", function (gltf) {",
          "  model = gltf.scene;",
          "...",
          "introAnimation()",
          "});",
          "",
          "// 모델 등장 애니메이션",
          "function introAnimation() {",
          "  gsap.to(modelGroup.scale, { x: 1, y: 1, z: 1, duration: 3 });",
          "}",
          "// 모델 퇴장 애니메이션",
