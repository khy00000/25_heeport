          "loadtl",
          "  .set(\".cursor\", { opacity: 0, scale: 0 })",
          "  .to(\".loading-logo\", { scale: 1, duration: 1 })",
          "  .to(\".loading\", { autoAlpha: 0, duration: 0.5 })",
          "  .to(\".introwrap-2\", { autoAlpha: 1, duration: 1 })"
        ],
        "aftercode": [
          "const loadtl = gsap.timeline();",
          "const hasVisited = sessionStorage.getItem(\"hasVisited\");",
          "",
          "if (!hasVisited) {",
          "  sessionStorage.setItem(\"hasVisited\", \"true\");",
          "",
          "  loadtl",
          "    .set(\".cursor\", { opacity: 0, scale: 0 })",
          "    .to(\".loading-logo\", { scale: 1, duration: 1 })",
          "    .to(\".loading\", { autoAlpha: 0, duration: 0.5 })",
          "    .to(\".introwrap-2\", { autoAlpha: 1, duration: 1 });",
          "",
          "} else {",
          "  // 두 번째 방문 이후에는 로딩 페이지 애니메이션 없이 진행",
          "  loadtl",
          "    .set([\".loading\", \".loading-logo\"], { autoAlpha: 0 })",
          "    .set(\".cursor\", { opacity: 0, scale: 0 })",
          "    .set(\".introwrap-2\", { autoAlpha: 1 });",
          "}"
        ]
      }
