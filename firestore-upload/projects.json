          "const FadeInGSAP = ({ children, delay = 0 }) => {",
          "const sectionRef = useRef();",
          "useEffect(() => {",
          "const el = sectionRef.current;",
          "gsap.fromTo(el,",
          "...",
          "// 자식 엘리먼트에 ref를 직접 전달해 구조를 그대로 유지",
          "if (isValidElement(children)) {",
          "  return cloneElement(children, { ref: sectionRef });",
          "}"
        ]
      },
      {
        "title": "Event 섹션 내 테이블 디자인이 Breakpoint에 따라 조건부 디자인 필요",
        "problem": "1024px 이상의 해상도에서는 4행 3열 레이아웃이 필요, 1024px 이하에서는 3행 4열, 모바일에서는 완전히 새로운 레이아웃과 Swiper 구성을 추가해야하는 문제",
        "solution": [
          "브라우저의 해상도 상태를 세분화할 수 있도록 useResponsive 커스텀 훅을 만들어 모바일(≤747), 태블릿(748~1024), 데스크탑(>1024) 구간으로 구분",
          "Event 섹션 컴포넌트 내부의 isMobile, isTablet, isDesktop 상태에 따라 조건부 렌더링",
          "반응형에 따라 필요한 해상도별 테이블 레이아웃 디자인을 위해 클래스를 다르게 적용",
          "useResponsive 훅은 추후 더 많은 디바이스 대응이 가능하도록 유연하게 설계"
        ],
        "beforecode": [
          "// 기존 useIsMobile 훅 (단일 breakpoint만 감지)",
          "const useIsMobile = (breakpoint = 1024) => {",
          "  const [isMobile, setIsMobile] = useState(window.innerWidth <= breakpoint);",
          "",
          "  useEffect(() => {",
          "    const handleResize = () => {",
          "      setIsMobile(window.innerWidth <= breakpoint);",
          "    };",
          "    window.addEventListener('resize', handleResize);",
          "    return () => window.removeEventListener('resize', handleResize);",
          "  }, [breakpoint]);",
          "",
          "  return isMobile;",
          "};"
        ],
        "aftercode": [
          "// 개선된 useResponsive 커스텀 훅",
          "const useResponsive = () => {",
          "  const getStatus = () => {",
          "    const width = window.innerWidth;",
          "    return {",
          "      isMobile: width <= 747,",
          "      isTablet: width > 747 && width <= 1024,",
          "      isDesktop: width > 1024",
          "    };",
          "  };",
          "",
          "  const [status, setStatus] = useState(getStatus());",
          "",
          "  useEffect(() => {",
          "    const handleResize = () => setStatus(getStatus());",
          "    window.addEventListener('resize', handleResize);",
          "    return () => window.removeEventListener('resize', handleResize);",
          "  }, []);",
          "",
          "  return status;",
          "};",
          "",
          "// Event 컴포넌트 내부",
          "const { isMobile, isTablet, isDesktop } = useResponsive();",
          "",
          "{isMobile ? ( <Swiper> ... </Swiper> ) :",
          "( <div className=\"event_table\"> ... </div> )",
          "// 조건부 클래스로 css 반응형 디자인",
          "className={`event_list_item",
          "  ${index === 0 ? 'first_item' : ''}",
          "  ${item.ad ? 'has-ad' : ''}",
          "  ${isDesktop && index > 5 ? 'bottom_item' : ''}",
          "  ${isDesktop && [2, 6].includes(index) ? 'item_3_7' : ''}",
          "  ${isTablet && [1, 4, 7].includes(index) ? 'item_3_7' : ''}",
          "  ${isTablet && index > 6 ? 'bottom_item' : ''}`"
        ]
      }
    ]
