          "const box = new THREE.Box3().setFromObject(model);",
          "const center = box.getCenter(new THREE.Vector3());",
          "model.position.sub(center);",
          "modelGroup.add(model);",
          "scene.add(modelGroup);",
          "...",
          "// 모델 사이즈를 기반으로 x, y, z 방향 중 가장 큰 축의 길이 체크 하여 전체가 잘 보이는 적절한 거리를 자동으로 계산",
          "const size = box.getSize(new THREE.Vector3());",
          "const maxDim = Math.max(size.x, size.y, size.z);",
          "camera.position.set(0, 0, maxDim * 2);",
          "...",
          "function animate() {",
          "// 매 프레임마다 회전값을 고정",
          "modelGroup.setRotationFromEuler(new THREE.Euler(Math.PI / 3, Math.PI / 6, 0));",
          "// 브라우저 기준 X축(수평축)으로 회전",
          "modelGroup.rotateOnWorldAxis(new THREE.Vector3(1, 0, 0), scrollProgress * Math.PI * 8);",
          "..."
        ]
